# ============================================================
# 如影 AI 能力开放平台 —— 服务端配置示例
# 读取顺序：先读进程环境变量，读不到再读项目根目录 .env（与 package.json 同级）。
# 复制为 .env 后填写，并执行 chmod 600 .env。密钥只在服务端，永不进入前端。
# ============================================================

PORT=8080

# 默认运行模式：true=演示（本地样例、不计费，默认）；false=真实（调用如影平台线上接口）
# 访客也可以在页面上自行切换；只有配置了下面的凭据，真实模式才可用。
RUYING_MOCK=true

# ---- 如影平台（真实模式必填）----
RUYING_APP_ID=
RUYING_APP_KEY=
RUYING_BASE_URL=https://aigc.softsugar.com
# TTS 音色 QID（视频口播与语音合成使用）
RUYING_TTS_QID=
# 视频口播使用的数字人形象图（可公网访问的图片地址）
RUYING_AVATAR_IMAGE_URL=
# 取 Token 签名时间戳单位：ms（默认）或 s
SIGN_TS_UNIT=ms
# 计费接口保护：false=拒绝计费接口（默认）；true=放行
ALLOW_BILLABLE=false

# ---- 知识库问答（可选）----
# 配置后，真实模式下检索命中时由 DeepSeek 依据资料生成回答；不配置则直接摘录资料原文
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 知识库数据目录（默认 ./data）
# KB_DIR=/app/data

# ---- 后台管理 ----
# 首次启动时自动创建超级管理员（只在还没有超级管理员时生效；首次登录必须改密码）。
# 也可以不设置，改用命令行：npm run admin -- create-super <用户名>
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# 厂商凭据（APP_KEY）加密密钥：设置后超级管理员才能在后台保存厂商凭据。设置后不要更换，否则已保存的凭据无法解密。
DATA_ENCRYPTION_KEY=
# 访客演示：true=未登录也能体验演示环境（默认）；false=工作台必须登录
PUBLIC_DEMO=true
# 开放接口：每个 API 密钥每分钟请求上限
OPEN_API_RATE_PER_MIN=120
# 使用日志保留天数
LOG_RETENTION_DAYS=180
# 会话 Cookie 的 Secure 标记：auto=按反向代理的 X-Forwarded-Proto 判断（默认）；true / false 强制
# COOKIE_SECURE=auto
# 数据库文件（默认 ./data/ruying.db）
# DB_FILE=/app/data/ruying.db

# ---- 其他（可选）----
# 反向代理没有去掉子路径前缀时，在这里填写，例如 /digital-human
# PUBLIC_BASE_PATH=
# 访问如影平台的超时（毫秒）
# UPSTREAM_TIMEOUT_MS=20000
# 演示模式任务耗时（毫秒）
MOCK_TASK_MS=1400
